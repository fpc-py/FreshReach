<view class="page-container">
  <view class="tabs">
    <view 
      class="{{['tab-item', currentTab === 'all' ? 'active' : '']}}"
      data-tab="all"
      bindtap="switchTab"
    >
      全部
    </view>
    <view 
      class="{{['tab-item', currentTab === 'picking' ? 'active' : '']}}"
      data-tab="picking"
      bindtap="switchTab"
    >
      待取货
    </view>
    <view 
      class="{{['tab-item', currentTab === 'delivering' ? 'active' : '']}}"
      data-tab="delivering"
      bindtap="switchTab"
    >
      配送中
    </view>
    <view 
      class="{{['tab-item', currentTab === 'completed' ? 'active' : '']}}"
      data-tab="completed"
      bindtap="switchTab"
    >
      已完成
    </view>
  </view>

  <view class="order-list" wx:if="{{filteredOrders.length > 0}}">
    <view class="order-card card" wx:for="{{filteredOrders}}" wx:key="id" data-order="{{item}}" bindtap="goToDetail">
      <view class="order-header">
        <text class="order-id">订单号: {{item.id}}</text>
        <text class="{{['order-status', 'status-' + item.status]}}">
          {{item.statusText}}
        </text>
      </view>

      <view class="order-address">
        <view class="address-item">
          <view class="dot shop-dot"></view>
          <view class="address-content">
            <text class="address-label">取货地址</text>
            <text class="address-detail">{{item.detail || '商家地址'}}</text>
          </view>
        </view>
        <view class="address-line"></view>
        <view class="address-item">
          <view class="dot user-dot"></view>
          <view class="address-content">
            <text class="address-label">收货地址</text>
            <text class="address-detail">{{item.province}}{{item.city}}{{item.district}}{{item.detail}}</text>
          </view>
        </view>
      </view>

      <view class="order-footer">
        <view class="order-info">
          <text class="delivery-fee">配送费 ¥{{item.deliveryFee}}</text>
          <text class="order-time">{{item.createTimeText}}</text>
        </view>
        <view class="order-actions">
          <button 
            wx:if="{{item.status === 'CONFIRMED' || item.status === 'PAID'}}" 
            class="btn-action btn-primary"
            data-order="{{item}}"
            catchtap="handlePickup"
          >
            确认取货
          </button>
          <button 
            wx:if="{{item.status === 'PICKED_UP' || item.status === 'DELIVERING'}}" 
            class="btn-action btn-primary"
            data-order="{{item}}"
            catchtap="handleDeliver"
          >
            确认送达
          </button>
        </view>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:else>
    <text class="empty-icon">📋</text>
    <text class="empty-text">暂无订单</text>
  </view>
</view>
