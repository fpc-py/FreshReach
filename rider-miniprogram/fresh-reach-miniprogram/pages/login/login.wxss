.login-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #FF6B35 0%, #FF8C5A 30%, #f5f5f5 60%);
  padding: 0 40rpx;
  display: flex;
  flex-direction: column;
}

.login-header {
  padding-top: 160rpx;
  text-align: center;
  margin-bottom: 120rpx;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  background: #fff;
  border-radius: 50%;
  margin: 0 auto 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 40rpx rgba(255, 107, 53, 0.3);
}

.logo-text {
  font-size: 40rpx;
  font-weight: bold;
  color: #FF6B35;
}

.slogan {
  font-size: 28rpx;
  color: #fff;
  opacity: 0.9;
}

.login-form {
  background: #fff;
  border-radius: 32rpx;
  padding: 60rpx 48rpx;
  box-shadow: 0 4rpx 30rpx rgba(0, 0, 0, 0.08);
}

.form-item {
  margin-bottom: 48rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 20rpx;
  font-weight: 500;
}

.input {
  width: 100%;
  height: 88rpx;
  border: 2rpx solid #e5e5e5;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.btn-login {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #FF6B35 0%, #FF8C5A 100%);
  color: #fff;
  border: none;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 500;
  margin-top: 20rpx;
}

.btn-login::after {
  border: none;
}

.btn-login[disabled] {
  opacity: 0.6;
}

.login-footer {
  margin-top: auto;
  padding: 60rpx 0;
  text-align: center;
}

.tips {
  font-size: 24rpx;
  color: #999;
}
