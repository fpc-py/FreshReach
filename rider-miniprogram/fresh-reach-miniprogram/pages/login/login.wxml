<view class="login-container">
  <view class="login-header">
    <view class="logo">
      <text class="logo-text">鲜达骑手</text>
    </view>
    <text class="slogan">快速接单，轻松赚钱</text>
  </view>

  <view class="login-form">
    <view class="form-item">
      <text class="label">手机号</text>
      <input
        class="input"
        type="number"
        value="{{phone}}"
        placeholder="请输入手机号"
        maxlength="11"
        bindinput="onPhoneInput"
      />
    </view>

    <view class="form-item">
      <text class="label">密码</text>
      <input
        class="input"
        password="{{true}}"
        value="{{password}}"
        placeholder="请输入密码"
        maxlength="20"
        bindinput="onPasswordInput"
        bindconfirm="handleLogin"
      />
    </view>

    <button class="btn-login" bindtap="handleLogin" disabled="{{loading}}">
      {{ loading ? '登录中...' : '登录' }}
    </button>
  </view>

  <view class="login-footer">
    <text class="tips">登录即表示同意《用户协议》和《隐私政策》</text>
  </view>
</view>
