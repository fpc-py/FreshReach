.page-container {
  padding: 0 0 200rpx 0;
  min-height: 100vh;
  background: #f5f5f5;
  overflow-y: auto;
}

.status-header {
  padding: 80rpx 40rpx;
  text-align: center;
  color: #fff;
}

.status-header.status-PENDING {
  background: linear-gradient(135deg, #faad14 0%, #ffc53d 100%);
}

.status-header.status-PAID,
.status-header.status-CONFIRMED {
  background: linear-gradient(135deg, #FF6B35 0%, #FF8C5A 100%);
}

.status-header.status-PICKED_UP,
.status-header.status-DELIVERING {
  background: linear-gradient(135deg, #1890ff 0%, #40a9ff 100%);
}

.status-header.status-DELIVERED,
.status-header.status-COMPLETED {
  background: linear-gradient(135deg, #52c41a 0%, #73d13d 100%);
}

.status-header.status-CANCELLED {
  background: linear-gradient(135deg, #999 0%, #bbb 100%);
}

.status-text {
  display: block;
  font-size: 44rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.status-tip {
  font-size: 26rpx;
  opacity: 0.9;
}

.section {
  margin: 30rpx;
  margin-bottom: 0;
}

.section + .section {
  margin-top: 30rpx;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.address-block {
  background: #fafafa;
  border-radius: 16rpx;
  padding: 24rpx;
}

.address-item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 12rpx 0;
}

.dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  margin-top: 10rpx;
  flex-shrink: 0;
}

.shop-dot {
  background: #FF6B35;
}

.user-dot {
  background: #52c41a;
}

.address-line {
  width: 2rpx;
  height: 40rpx;
  background: #e5e5e5;
  margin-left: 9rpx;
}

.address-info {
  flex: 1;
}

.address-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 6rpx;
}

.address-detail {
  font-size: 28rpx;
  color: #333;
  line-height: 1.4;
}

.contact {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-top: 8rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}

.info-label {
  font-size: 28rpx;
  color: #666;
}

.info-value {
  font-size: 28rpx;
  color: #333;
}

.total-row {
  padding-top: 24rpx;
  margin-top: 10rpx;
  border-top: 2rpx dashed #f0f0f0;
}

.text-primary {
  color: #FF6B35;
  font-weight: bold;
}

.goods-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.goods-item:last-child {
  border-bottom: none;
}

.goods-image {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
  margin-right: 24rpx;
}

.goods-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.goods-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.goods-spec {
  font-size: 24rpx;
  color: #999;
}

.goods-right {
  text-align: right;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.goods-price {
  font-size: 28rpx;
  color: #FF6B35;
  font-weight: bold;
}

.goods-count {
  font-size: 24rpx;
  color: #999;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 24rpx 40rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.btn-action {
  height: 88rpx;
  border: none;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.btn-action::after {
  border: none;
}

.btn-full {
  width: 100%;
  background: linear-gradient(135deg, #FF6B35 0%, #FF8C5A 100%);
  color: #fff;
}

.btn-disabled {
  background: #ccc;
  color: #fff;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #666;
}
