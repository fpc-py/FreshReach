<view class="page-container" wx:if="{{order}}">
  <view class="status-header {{'status-' + order.status}}">
    <text class="status-text">{{order.statusText}}</text>
    <text class="status-tip" wx:if="{{order.status === 'CONFIRMED' || order.status === 'PAID'}}">请尽快前往取货</text>
    <text class="status-tip" wx:elif="{{order.status === 'PICKED_UP' || order.status === 'DELIVERING'}}">正在配送中，请尽快送达</text>
  </view>

  <view class="section card">
    <view class="section-title">配送信息</view>
    
    <view class="address-block">
      <view class="address-item">
        <view class="dot shop-dot"></view>
        <view class="address-info">
          <text class="address-label">取货地址</text>
          <text class="address-detail">商家地址</text>
        </view>
      </view>
      <view class="address-line"></view>
      <view class="address-item">
        <view class="dot user-dot"></view>
        <view class="address-info">
          <text class="address-label">收货地址</text>
          <text class="address-detail">{{order.province}}{{order.city}}{{order.district}}{{order.detail}}</text>
          <text class="contact" wx:if="{{order.contactName || order.contactPhone}}">
            {{order.contactName}} {{order.contactPhone}}
          </text>
        </view>
      </view>
    </view>
  </view>

  <view class="section card">
    <view class="section-title">订单信息</view>
    <view class="info-row">
      <text class="info-label">订单编号</text>
      <text class="info-value">{{order.id}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">下单时间</text>
      <text class="info-value">{{order.createTimeText}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">商品金额</text>
      <text class="info-value">¥{{order.totalAmount}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">配送费</text>
      <text class="info-value text-primary">¥{{order.deliveryFee}}</text>
    </view>
    <view class="info-row total-row" wx:if="{{order.remark}}">
      <text class="info-label">备注</text>
      <text class="info-value">{{order.remark}}</text>
    </view>
  </view>

  <view class="section card">
    <view class="section-title">商品列表</view>
    <view class="goods-item" wx:for="{{order.items}}" wx:key="id">
      <image class="goods-image" src="{{item.image || '/images/placeholder.png'}}" mode="aspectFill" />
      <view class="goods-info">
        <text class="goods-name">{{item.name}}</text>
        <text class="goods-spec">{{item.spec || ''}}</text>
      </view>
      <view class="goods-right">
        <text class="goods-price">¥{{item.price}}</text>
        <text class="goods-count">x{{item.quantity}}</text>
      </view>
    </view>
  </view>

  <view class="bottom-bar">
    <button 
      wx:if="{{order.status === 'CONFIRMED' || order.status === 'PAID'}}" 
      class="btn-action btn-full"
      bindtap="handlePickup"
    >
      确认取货
    </button>
    <button 
      wx:elif="{{order.status === 'PICKED_UP' || order.status === 'DELIVERING'}}" 
      class="btn-action btn-full"
      bindtap="handleDeliver"
    >
      确认送达
    </button>
    <button 
      wx:else
      class="btn-action btn-full btn-disabled"
      disabled
    >
      订单已完成
    </button>
  </view>
</view>

<view class="empty-state" wx:else>
  <text class="empty-icon">📋</text>
  <text class="empty-text">加载中...</text>
</view>
