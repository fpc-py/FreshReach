.page-container {
  padding: 30rpx;
  padding-bottom: 160rpx;
  min-height: 100vh;
  overflow-y: auto;
}

.status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.status-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.status-label {
  font-size: 28rpx;
  color: #666;
}

.status-value {
  font-size: 32rpx;
  font-weight: bold;
}

.status-value.online {
  color: #52c41a;
}

.status-value.offline {
  color: #999;
}

.switch {
  position: relative;
  display: inline-block;
}

.switch-track {
  width: 100rpx;
  height: 56rpx;
  background-color: #ccc;
  border-radius: 56rpx;
  position: relative;
  transition: all 0.3s;
}

.switch-track.active {
  background-color: #FF6B35;
}

.switch-thumb {
  position: absolute;
  left: 4rpx;
  top: 4rpx;
  width: 48rpx;
  height: 48rpx;
  background-color: white;
  border-radius: 50%;
  transition: all 0.3s;
}

.switch-track.active .switch-thumb {
  transform: translateX(44rpx);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 10rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.refresh-btn {
  font-size: 26rpx;
  color: #FF6B35;
}

.order-card {
  margin-bottom: 30rpx;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  padding-bottom: 24rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.order-id {
  font-size: 26rpx;
  color: #666;
}

.delivery-fee {
  font-size: 32rpx;
  font-weight: bold;
  color: #FF6B35;
}

.order-address {
  margin-bottom: 30rpx;
}

.address-item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 10rpx 0;
}

.dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  margin-top: 10rpx;
  flex-shrink: 0;
}

.shop-dot {
  background: #FF6B35;
}

.user-dot {
  background: #52c41a;
}

.address-line {
  width: 2rpx;
  height: 40rpx;
  background: #e5e5e5;
  margin-left: 9rpx;
}

.address-content {
  flex: 1;
}

.address-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 6rpx;
}

.address-detail {
  font-size: 28rpx;
  color: #333;
  line-height: 1.4;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 24rpx;
  border-top: 2rpx solid #f0f0f0;
}

.order-time {
  font-size: 24rpx;
  color: #999;
}

.btn-grab {
  background: linear-gradient(135deg, #FF6B35 0%, #FF8C5A 100%);
  color: #fff;
  border: none;
  border-radius: 40rpx;
  padding: 16rpx 40rpx;
  font-size: 26rpx;
  line-height: 1.4;
}

.btn-grab::after {
  border: none;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.empty-tip {
  font-size: 24rpx;
  color: #999;
}
