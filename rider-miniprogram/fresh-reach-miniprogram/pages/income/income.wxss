.page-container {
  padding: 0 0 160rpx 0;
  min-height: 100vh;
  background: #f5f5f5;
  overflow-y: auto;
}

.income-header {
  background: linear-gradient(135deg, #FF6B35 0%, #FF8C5A 100%);
  padding: 60rpx 40rpx 80rpx;
  color: #fff;
}

.income-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}

.title-text {
  font-size: 32rpx;
  font-weight: 500;
}

.period-picker {
  font-size: 26rpx;
  background: rgba(255, 255, 255, 0.2);
  padding: 8rpx 24rpx;
  border-radius: 32rpx;
}

.income-amount {
  text-align: center;
}

.amount-label {
  display: block;
  font-size: 26rpx;
  opacity: 0.8;
  margin-bottom: 16rpx;
}

.amount-value {
  font-size: 80rpx;
  font-weight: bold;
  line-height: 1;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  padding: 0 30rpx;
  margin-top: -40rpx;
  position: relative;
  z-index: 10;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.stat-item {
  text-align: center;
}

.stat-value {
  display: block;
  font-size: 44rpx;
  font-weight: bold;
  color: #FF6B35;
  margin-bottom: 12rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #666;
}

.section-header {
  padding: 40rpx 30rpx 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.income-list {
  padding: 0 30rpx;
}

.income-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.income-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.income-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.income-time {
  font-size: 24rpx;
  color: #999;
}

.income-amount {
  font-size: 32rpx;
  font-weight: bold;
}

.text-primary {
  color: #FF6B35;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #666;
}
