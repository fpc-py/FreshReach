<view class="page-container">
  <view class="income-header">
    <view class="income-title">
      <text class="title-text">{{periodText}}收入</text>
      <picker mode="selector" range="{{periods}}" value="{{periodIndex}}" bindchange="onPeriodChange">
        <view class="period-picker">
          {{periods[periodIndex]}} ▾
        </view>
      </picker>
    </view>
    <view class="income-amount">
      <text class="amount-label">累计收入</text>
      <text class="amount-value">¥{{stats.totalAmount || 0}}</text>
    </view>
  </view>

  <view class="stats-grid">
    <view class="stat-item card">
      <text class="stat-value">{{stats.totalOrders || 0}}</text>
      <text class="stat-label">总订单数</text>
    </view>
    <view class="stat-item card">
      <text class="stat-value">{{stats.completedOrders || 0}}</text>
      <text class="stat-label">已完成</text>
    </view>
    <view class="stat-item card">
      <text class="stat-value">¥{{stats.totalDeliveryFee || 0}}</text>
      <text class="stat-label">配送费</text>
    </view>
    <view class="stat-item card">
      <text class="stat-value">{{stats.todayOrders || 0}}</text>
      <text class="stat-label">今日订单</text>
    </view>
  </view>

  <view class="section-header">
    <text class="section-title">收入明细</text>
  </view>

  <view class="income-list" wx:if="{{incomeList.length > 0}}">
    <view class="income-item card" wx:for="{{incomeList}}" wx:key="id">
      <view class="income-info">
        <text class="income-title">{{item.orderId || '订单收入'}}</text>
        <text class="income-time">{{item.timeText}}</text>
      </view>
      <text class="income-amount text-primary">+¥{{item.amount}}</text>
    </view>
  </view>

  <view class="empty-state" wx:else>
    <text class="empty-icon">💰</text>
    <text class="empty-text">暂无收入记录</text>
  </view>
</view>
