.page-container {
  padding: 0 0 160rpx 0;
  min-height: 100vh;
  background: #f5f5f5;
  overflow-y: auto;
}

.profile-header {
  background: linear-gradient(135deg, #FF6B35 0%, #FF8C5A 100%);
  padding: 80rpx 40rpx 120rpx;
  display: flex;
  align-items: center;
  position: relative;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 32rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
}

.avatar-text {
  font-size: 56rpx;
  color: #fff;
  font-weight: bold;
}

.user-info {
  flex: 1;
}

.username {
  display: block;
  font-size: 36rpx;
  color: #fff;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.phone {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.status-badge {
  padding: 8rpx 28rpx;
  border-radius: 40rpx;
  font-size: 24rpx;
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
}

.status-badge.online {
  background: rgba(82, 196, 26, 0.3);
}

.status-card {
  margin: -60rpx 30rpx 30rpx;
  position: relative;
  z-index: 10;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.status-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.status-label {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.status-control {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.status-text {
  font-size: 28rpx;
  font-weight: 500;
}

.status-text.online {
  color: #52c41a;
}

.status-text.offline {
  color: #999;
}

.switch {
  position: relative;
  display: inline-block;
}

.switch-track {
  width: 100rpx;
  height: 56rpx;
  background-color: #ccc;
  border-radius: 56rpx;
  position: relative;
  transition: all 0.3s;
}

.switch-track.active {
  background-color: #FF6B35;
}

.switch-thumb {
  position: absolute;
  left: 4rpx;
  top: 4rpx;
  width: 48rpx;
  height: 48rpx;
  background-color: white;
  border-radius: 50%;
  transition: all 0.3s;
}

.switch-track.active .switch-thumb {
  transform: translateX(44rpx);
}

.menu-list {
  padding: 0 30rpx;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.menu-icon {
  font-size: 44rpx;
}

.menu-title {
  font-size: 30rpx;
  color: #333;
}

.menu-arrow {
  font-size: 48rpx;
  color: #ccc;
}

.logout-section {
  padding: 60rpx 30rpx;
  margin-top: 40rpx;
}

.btn-logout {
  width: 100%;
  height: 88rpx;
  background: #fff;
  color: #FF4D4F;
  border: none;
  border-radius: 16rpx;
  font-size: 30rpx;
}

.btn-logout::after {
  border: none;
}
