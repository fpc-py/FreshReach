<view class="page-container">
  <view class="profile-header">
    <view class="avatar">
      <text class="avatar-text">{{usernameFirst}}</text>
    </view>
    <view class="user-info">
      <text class="username">{{riderInfo.username || '骑手用户'}}</text>
      <text class="phone">{{riderInfo.phone}}</text>
    </view>
    <view class="{{['status-badge', isOnline ? 'online' : 'offline']}}">
      {{ isOnline ? '在线' : '离线' }}
    </view>
  </view>

  <view class="status-card card">
    <view class="status-item">
      <text class="status-label">工作状态</text>
      <view class="status-control">
        <text class="{{['status-text', isOnline ? 'online' : 'offline']}}">
          {{ isOnline ? '已上线' : '已下线' }}
        </text>
        <view class="switch" bindtap="toggleStatus">
          <view class="switch-track {{isOnline ? 'active' : ''}}">
            <view class="switch-thumb"></view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="menu-list">
    <view class="menu-item card" bindtap="goToIncome">
      <view class="menu-left">
        <text class="menu-icon">💰</text>
        <text class="menu-title">收入统计</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-item card" bindtap="goToOrders">
      <view class="menu-left">
        <text class="menu-icon">📋</text>
        <text class="menu-title">我的订单</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-item card">
      <view class="menu-left">
        <text class="menu-icon">📞</text>
        <text class="menu-title">联系客服</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-item card">
      <view class="menu-left">
        <text class="menu-icon">⚙️</text>
        <text class="menu-title">设置</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="logout-section">
    <button class="btn-logout" bindtap="handleLogout">退出登录</button>
  </view>
</view>
